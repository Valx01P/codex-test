#!/usr/bin/env bash
set -euo pipefail

VERSION="0.2.0"
SKILL_NAME="codex-test"
USER_SKILL_DIR="${CODEX_TEST_SKILL_DIR:-$HOME/.agents/skills/$SKILL_NAME}"
REPORT_FILE="CODEX-TEST-REPORT.md"

DEFAULT_PROMPT='Use $codex-test. Inspect this repository for test gaps, propose a prioritized plan, generate the approved high-impact tests, validate them, and write CODEX-TEST-REPORT.md explaining every created or updated file.'
EXEC_PROMPT='Use $codex-test in non-interactive mode. Inspect this repository for test gaps, choose up to 5 high-impact targets, generate focused tests, validate them, and write CODEX-TEST-REPORT.md explaining every created or updated file. Do not install dependencies or edit product source unless they are already part of the repository setup.'

usage() {
  cat <<EOF
codex-test v${VERSION}

Agentic test planning, generation, validation, and reporting for Codex.

Usage:
  codex-test                     Open Codex with the codex-test workflow
  codex-test --exec              Run non-interactively with a bounded default plan
  codex-test --exec --go-ham     Run headless with approval policy "never"
  codex-test --plan-only         Inspect the repo and stop after the proposed plan
  codex-test --goal "..."        Add a testing goal, bug, workflow, or area to focus on
  codex-test --install           Install this skill for the current user
  codex-test --install-repo      Install this skill into .agents/skills/codex-test
  codex-test --uninstall         Remove the user skill and this wrapper if possible
  codex-test --print-codex-function
                                 Print an optional shell function for "codex test"
  codex-test --help              Show this help

Examples:
  codex-test
  codex-test --goal "focus on checkout form validation"
  codex-test --exec --go-ham --goal "modern Next.js frontend coverage"
  codex-test --install-repo

What it does:
  1. Scans the repo and existing tests
  2. Recommends high-impact unit, component, integration, UI, e2e, or domain tests
  3. Lets an interactive user adjust the plan before edits
  4. Generates tests that match local conventions
  5. Runs narrow validation commands
  6. Writes ${REPORT_FILE} as a human-reviewable draft

Approval modes:
  Default interactive runs use Codex's normal approval flow.
  --exec uses workspace-write sandboxing so tests and the report can be written.
  --go-ham passes --ask-for-approval never while keeping workspace-write
  sandboxing. Use it only in a trusted repository.

Codex CLI:
  This repository cannot register a native "codex test" subcommand in Codex.
  To get that spelling in your shell, run:
    codex-test --print-codex-function

EOF
}

err() {
  printf 'codex-test: %s\n' "$*" >&2
}

find_source_dir() {
  local script_dir
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

  if [[ -f "$script_dir/SKILL.md" ]]; then
    printf '%s\n' "$script_dir"
    return 0
  fi

  if [[ -f "$(dirname "$script_dir")/SKILL.md" ]]; then
    dirname "$script_dir"
    return 0
  fi

  if [[ -f "$USER_SKILL_DIR/SKILL.md" ]]; then
    printf '%s\n' "$USER_SKILL_DIR"
    return 0
  fi

  return 1
}

copy_skill() {
  local src="$1"
  local dest="$2"

  if [[ ! -f "$src/SKILL.md" ]]; then
    err "cannot find SKILL.md in $src"
    return 1
  fi

  mkdir -p "$dest"
  cp "$src/SKILL.md" "$dest/"

  if [[ -d "$src/scripts" ]]; then
    rm -rf "$dest/scripts"
    cp -R "$src/scripts" "$dest/scripts"
    chmod +x "$dest/scripts/"*.sh 2>/dev/null || true
  fi

  if [[ -d "$src/references" ]]; then
    rm -rf "$dest/references"
    cp -R "$src/references" "$dest/references"
  fi

  if [[ -d "$src/agents" ]]; then
    rm -rf "$dest/agents"
    cp -R "$src/agents" "$dest/agents"
  fi
}

install_user_skill() {
  local src
  src="$(find_source_dir)" || {
    err "cannot find the codex-test source directory"
    exit 1
  }

  copy_skill "$src" "$USER_SKILL_DIR"

  printf 'Installed %s skill to %s\n' "$SKILL_NAME" "$USER_SKILL_DIR"
  printf 'Use it in Codex as $%s, or run codex-test from a repository.\n' "$SKILL_NAME"
  printf 'If Codex is already running and the skill does not appear, restart Codex.\n'
}

install_repo_skill() {
  local src dest
  src="$(find_source_dir)" || {
    err "cannot find the codex-test source directory"
    exit 1
  }

  dest=".agents/skills/$SKILL_NAME"
  copy_skill "$src" "$dest"

  printf 'Installed repo-local skill to %s\n' "$dest"
  printf 'Commit that directory so teammates get the same workflow.\n'
}

uninstall_user_skill() {
  local wrapper current_script current_dir
  rm -rf "$USER_SKILL_DIR"

  wrapper="$(command -v codex-test 2>/dev/null || true)"
  current_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  current_script="$current_dir/$(basename "${BASH_SOURCE[0]}")"

  if [[ -n "$wrapper" && "$wrapper" == "$current_script" && -f "$current_dir/SKILL.md" ]]; then
    printf 'Removed skill %s\n' "$USER_SKILL_DIR"
    printf 'Leaving source checkout wrapper in place at %s\n' "$wrapper"
  elif [[ -n "$wrapper" && -w "$wrapper" ]]; then
    rm -f "$wrapper"
    printf 'Removed wrapper %s\n' "$wrapper"
  else
    printf 'Removed skill %s\n' "$USER_SKILL_DIR"
    if [[ -n "$wrapper" ]]; then
      printf 'Wrapper still exists at %s. Remove it manually if desired.\n' "$wrapper"
    fi
  fi
}

print_codex_function() {
  cat <<'EOF'
# Add this to ~/.zshrc, ~/.bashrc, or your shell profile, then restart the shell.
# It forwards "codex test ..." to codex-test and leaves every other codex command alone.
codex() {
  if [ "$#" -gt 0 ] && [ "$1" = "test" ]; then
    shift
    command codex-test "$@"
  else
    command codex "$@"
  fi
}
EOF
}

MODE="interactive"
JSON_ARGS=()
GO_HAM=false
PLAN_ONLY=false
GOAL=""
EXTRA_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --exec|-e)
      MODE="exec"
      shift
      ;;
    --json)
      JSON_ARGS=(--json)
      shift
      ;;
    --go-ham|--yes|--auto)
      GO_HAM=true
      shift
      ;;
    --plan-only|--dry-run)
      PLAN_ONLY=true
      shift
      ;;
    --goal|--focus|--target)
      if [[ $# -lt 2 ]]; then
        err "$1 requires a value"
        exit 2
      fi
      GOAL="$2"
      shift 2
      ;;
    --install)
      install_user_skill
      exit 0
      ;;
    --install-repo)
      install_repo_skill
      exit 0
      ;;
    --uninstall)
      uninstall_user_skill
      exit 0
      ;;
    --print-codex-function)
      print_codex_function
      exit 0
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --version|-v)
      printf 'codex-test v%s\n' "$VERSION"
      exit 0
      ;;
    *)
      EXTRA_ARGS+=("$1")
      shift
      ;;
  esac
done

if ! command -v codex >/dev/null 2>&1; then
  err "Codex CLI not found. Install it with: npm install -g @openai/codex"
  err "On macOS you can also use: brew install --cask codex"
  exit 1
fi

PROMPT="$DEFAULT_PROMPT"
if [[ "$MODE" == "exec" ]]; then
  PROMPT="$EXEC_PROMPT"
fi

if [[ "$PLAN_ONLY" == true ]]; then
  PROMPT="$PROMPT Stop after writing the proposed plan in chat. Do not edit files."
fi

if [[ -n "$GOAL" ]]; then
  PROMPT="$PROMPT User testing goal: $GOAL"
fi

CODEX_ARGS=()
if [[ "$MODE" == "exec" ]]; then
  CODEX_ARGS=(--sandbox workspace-write)
fi
if [[ "$GO_HAM" == true ]]; then
  CODEX_ARGS=(--ask-for-approval never --sandbox workspace-write)
fi

if [[ "$MODE" == "exec" ]]; then
  exec codex exec \
    "${CODEX_ARGS[@]}" \
    "${JSON_ARGS[@]}" \
    "${EXTRA_ARGS[@]}" \
    "$PROMPT"
fi

exec codex \
  "${CODEX_ARGS[@]}" \
  "${EXTRA_ARGS[@]}" \
  "$PROMPT"
