#!/usr/bin/env bash
set -euo pipefail

VERSION="0.3.0"
SKILL_NAME="codex-test"
USER_SKILL_DIR="${CODEX_TEST_SKILL_DIR:-$HOME/.agents/skills/$SKILL_NAME}"
REPORT_FILE="CODEX-TEST-REPORT.md"
SHELL_MARKER_START="# >>> codex-test shell integration >>>"
SHELL_MARKER_END="# <<< codex-test shell integration <<<"

DEFAULT_PROMPT='Use $codex-test. Before running commands, inspecting the repository, planning, or editing, show exactly: 1. Recommended Test Scan, 2. Increase Test Coverage, 3. Specialized Test Development. Wait for the user to reply with 1, 2, or 3. Do not infer the workflow from the user goal or context. After selection, run that workflow, generate approved production-ready tests, validate them, and write a concise CODEX-TEST-REPORT.md with overview tables, grouped details, impact, CI/runtime and flake-risk notes, and next steps.'
EXEC_PROMPT='Use $codex-test in non-interactive mode with the explicitly requested workflow mode. Do not infer a workflow from the user goal. For coverage mode, target 80% unless another threshold is provided; cover lower-complexity meaningful gaps first. Generate focused production-ready tests, validate them, and write a concise CODEX-TEST-REPORT.md with overview tables, grouped details, impact, CI/runtime and flake-risk notes, and next steps. Do not install dependencies or edit product source unless already part of repo setup.'

usage() {
  cat <<EOF
codex-test v${VERSION}

Agentic test planning, generation, validation, and reporting for Codex.

Usage:
  codex-test                     Open Codex with the codex-test workflow
  codex-test --exec --mode MODE  Run non-interactively with an explicit mode
  codex-test --exec --mode MODE --go-ham
                                 Run headless with approval policy "never"
  codex-test --plan-only         Inspect the repo and stop after the proposed plan
  codex-test --goal "..."        Add a testing goal, bug, workflow, or area to focus on
  codex-test --mode "..."        Set exec mode: recommended, coverage, or specialized
  codex-test --coverage-target N Set a coverage target for coverage mode
  codex-test --test-kind "..."   Focus specialized tests, e.g. e2e or regression
  codex-test --install           Install the skill, wrapper, and "codex test"
  codex-test --install-repo      Install this skill into .agents/skills/codex-test
  codex-test --uninstall         Remove the user skill and this wrapper if possible
  codex-test --check             Check whether codex-test is installed correctly
  codex-test --print-codex-function
                                 Print the shell function used for "codex test"
  codex-test --help              Show this help

Examples:
  codex-test
  codex-test --goal "focus on checkout form validation"
  codex-test --exec --mode coverage --coverage-target 85
  codex-test --exec --mode specialized --test-kind e2e --goal "checkout smoke flow"
  codex-test --exec --mode coverage --go-ham --goal "modern Next.js frontend coverage"
  codex-test --install-repo

What it does:
  1. Offers three workflow options before starting:
     Recommended Test Scan, Increase Test Coverage, or Specialized Test Development
  2. Waits for an interactive user to reply with 1, 2, or 3
  3. Scans the repo, dependencies, and existing tests
  4. Recommends high-impact unit, component, integration, UI, e2e, or domain tests
  5. Lets an interactive user adjust the plan before edits
  6. Generates tests that match local conventions
  7. Runs narrow validation commands
  8. Writes ${REPORT_FILE} as a human-reviewable draft

Approval modes:
  Default interactive runs use Codex's normal approval flow.
  --exec requires --mode recommended, --mode coverage, or --mode specialized.
  It uses workspace-write sandboxing so tests and the report can be written.
  --go-ham passes --ask-for-approval never while keeping workspace-write
  sandboxing. Use it only in a trusted repository.

Codex CLI:
  This repository cannot register a native "codex test" subcommand in Codex.
  The installer adds a shell function so "codex test" works in your terminal.

EOF
}

err() {
  printf 'codex-test: %s\n' "$*" >&2
}

find_source_dir() {
  local script_dir
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

  if [[ -f "$script_dir/SKILL.md" ]]; then
    printf '%s\n' "$script_dir"
    return 0
  fi

  if [[ -f "$(dirname "$script_dir")/SKILL.md" ]]; then
    dirname "$script_dir"
    return 0
  fi

  if [[ -f "$USER_SKILL_DIR/SKILL.md" ]]; then
    printf '%s\n' "$USER_SKILL_DIR"
    return 0
  fi

  return 1
}

copy_skill() {
  local src="$1"
  local dest="$2"

  if [[ ! -f "$src/SKILL.md" ]]; then
    err "cannot find SKILL.md in $src"
    return 1
  fi

  mkdir -p "$dest"
  cp "$src/SKILL.md" "$dest/"

  if [[ -d "$src/scripts" ]]; then
    rm -rf "$dest/scripts"
    cp -R "$src/scripts" "$dest/scripts"
    chmod +x "$dest/scripts/"*.sh 2>/dev/null || true
  fi

  if [[ -d "$src/references" ]]; then
    rm -rf "$dest/references"
    cp -R "$src/references" "$dest/references"
  fi

  if [[ -d "$src/agents" ]]; then
    rm -rf "$dest/agents"
    cp -R "$src/agents" "$dest/agents"
  fi
}

choose_bin_dir() {
  if [[ -n "${CODEX_TEST_BIN_DIR:-}" ]]; then
    printf '%s\n' "$CODEX_TEST_BIN_DIR"
    return 0
  fi

  local dir
  IFS=':' read -r -a path_dirs <<< "${PATH:-}"
  for dir in "${path_dirs[@]}"; do
    [[ -z "$dir" ]] && continue
    [[ "$dir" == "/bin" || "$dir" == "/usr/bin" || "$dir" == "/sbin" || "$dir" == "/usr/sbin" ]] && continue
    if [[ -d "$dir" && -w "$dir" ]]; then
      printf '%s\n' "$dir"
      return 0
    fi
  done

  if [[ -d "/usr/local/bin" && -w "/usr/local/bin" ]]; then
    printf '%s\n' "/usr/local/bin"
    return 0
  fi

  printf '%s\n' "$HOME/.local/bin"
}

escape_double_quotes() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\$/\\$/g; s/`/\\`/g'
}

normalize_test_mode() {
  local value="$1"
  local normalized
  normalized="$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]' | tr '_' '-')"

  case "$normalized" in
    1|recommended|recommend|scan|recommended-scan|recommended-test-scan)
      printf 'recommended\n'
      ;;
    2|coverage|cover|increase-coverage|test-coverage|coverage-growth)
      printf 'coverage\n'
      ;;
    3|specialized|specialised|suite|custom|test-suite|test-development)
      printf 'specialized\n'
      ;;
    *)
      return 1
      ;;
  esac
}

normalize_coverage_target() {
  local value="$1"
  local normalized
  normalized="$(printf '%s' "$value" | tr -d '[:space:]%')"

  [[ "$normalized" =~ ^[0-9]+([.][0-9]+)?$ ]] || return 1
  awk -v value="$normalized" 'BEGIN { exit !(value > 0 && value <= 100) }' || return 1
  printf '%s\n' "$normalized"
}

shell_profiles() {
  if [[ -n "${CODEX_TEST_SHELL_PROFILE:-}" ]]; then
    printf '%s\n' "$CODEX_TEST_SHELL_PROFILE"
    return 0
  fi

  case "$(basename "${SHELL:-}")" in
    zsh)
      printf '%s\n' "$HOME/.zshrc"
      ;;
    bash)
      printf '%s\n' "$HOME/.bashrc"
      if [[ "$(uname -s 2>/dev/null || true)" == "Darwin" ]]; then
        printf '%s\n' "$HOME/.bash_profile"
      fi
      ;;
    fish)
      printf '%s\n' "$HOME/.config/fish/config.fish"
      ;;
    *)
      printf '%s\n' "$HOME/.profile"
      ;;
  esac
}

first_shell_profile() {
  local profile
  while IFS= read -r profile; do
    [[ -z "$profile" ]] && continue
    printf '%s\n' "$profile"
    return 0
  done < <(shell_profiles)
}

all_known_shell_profiles() {
  printf '%s\n' \
    "$HOME/.zshrc" \
    "$HOME/.bashrc" \
    "$HOME/.bash_profile" \
    "$HOME/.profile" \
    "$HOME/.config/fish/config.fish"
}

write_shell_block() {
  local profile="$1"
  local wrapper="$2"
  local tmp
  local escaped_wrapper

  mkdir -p "$(dirname "$profile")"
  tmp="$(mktemp)"
  if [[ -f "$profile" ]]; then
    awk -v start="$SHELL_MARKER_START" -v end="$SHELL_MARKER_END" '
      $0 == start { skip = 1; next }
      $0 == end { skip = 0; next }
      !skip { print }
    ' "$profile" > "$tmp"
  else
    : > "$tmp"
  fi

  escaped_wrapper="$(escape_double_quotes "$wrapper")"
  {
    cat "$tmp"
    printf '\n%s\n' "$SHELL_MARKER_START"
    printf '# Enables: codex test ...\n'
    if [[ "$(basename "$profile")" == "config.fish" ]]; then
      printf 'function codex\n'
      printf '  if test (count $argv) -gt 0; and test $argv[1] = test\n'
      printf '    set -e argv[1]\n'
      printf '    "%s" $argv\n' "$escaped_wrapper"
      printf '  else\n'
      printf '    command codex $argv\n'
      printf '  end\n'
      printf 'end\n'
    else
      printf 'codex() {\n'
      printf '  if [ "$#" -gt 0 ] && [ "$1" = "test" ]; then\n'
      printf '    shift\n'
      printf '    "%s" "$@"\n' "$escaped_wrapper"
      printf '  else\n'
      printf '    command codex "$@"\n'
      printf '  fi\n'
      printf '}\n'
    fi
    printf '%s\n' "$SHELL_MARKER_END"
  } > "$profile"
  rm -f "$tmp"
}

install_shell_integration() {
  local wrapper="$1"
  local profile
  local installed=""

  [[ "${CODEX_TEST_NO_SHELL:-}" == "1" ]] && return 0

  while IFS= read -r profile; do
    [[ -z "$profile" ]] && continue
    write_shell_block "$profile" "$wrapper"
    installed="${installed}${profile}"$'\n'
  done < <(shell_profiles)

  if [[ -n "$installed" ]]; then
    printf 'Shell integration installed for:\n'
    printf '%s' "$installed" | sed '/^$/d; s/^/  /'
  fi
}

shell_reload_command() {
  if [[ -n "${CODEX_TEST_SHELL_PROFILE:-}" ]]; then
    printf 'source "%s"\n' "$CODEX_TEST_SHELL_PROFILE"
    return 0
  fi

  case "$(basename "${SHELL:-}")" in
    zsh)
      printf 'source "%s"\n' "$HOME/.zshrc"
      ;;
    bash)
      printf 'source "%s"\n' "$HOME/.bashrc"
      ;;
    fish)
      printf 'source "%s"\n' "$HOME/.config/fish/config.fish"
      ;;
    *)
      printf 'restart your terminal\n'
      ;;
  esac
}

verify_shell_integration() {
  local profile="$1"
  local shell_name
  shell_name="$(basename "${SHELL:-}")"

  case "$shell_name" in
    zsh)
      command -v zsh >/dev/null 2>&1 && zsh -lc "source '$profile' >/dev/null 2>&1; codex test --version" >/dev/null 2>&1
      ;;
    bash)
      command -v bash >/dev/null 2>&1 && bash -lc "source '$profile' >/dev/null 2>&1; codex test --version" >/dev/null 2>&1
      ;;
    fish)
      command -v fish >/dev/null 2>&1 && fish -c "source '$profile' >/dev/null 2>&1; codex test --version" >/dev/null 2>&1
      ;;
    *)
      return 1
      ;;
  esac
}

finish_setup_message() {
  local wrapper="$1"
  local profile="$2"
  local reload_cmd

  reload_cmd="$(shell_reload_command)"
  if "$wrapper" --version >/dev/null 2>&1; then
    printf 'Verified: codex-test --version\n'
  fi
  if [[ -n "$profile" ]] && verify_shell_integration "$profile"; then
    printf 'Verified in a fresh shell: codex test --version\n'
  fi

  printf '\nUse it now:\n'
  printf '  %s\n' "$reload_cmd"
  printf '  codex test --version\n'
  printf '\nOr open a new terminal and run:\n'
  printf '  codex test\n'
}

remove_shell_block() {
  local profile="$1"
  local tmp

  [[ -f "$profile" ]] || return 0
  tmp="$(mktemp)"
  awk -v start="$SHELL_MARKER_START" -v end="$SHELL_MARKER_END" '
    $0 == start { skip = 1; changed = 1; next }
    $0 == end { skip = 0; next }
    !skip { print }
    END { if (!changed) exit 2 }
  ' "$profile" > "$tmp" || {
    rm -f "$tmp"
    return 0
  }
  mv "$tmp" "$profile"
  printf 'Removed shell integration from %s\n' "$profile"
}

uninstall_shell_integration() {
  local profile
  if [[ -n "${CODEX_TEST_SHELL_PROFILE:-}" ]]; then
    remove_shell_block "$CODEX_TEST_SHELL_PROFILE"
  fi
  while IFS= read -r profile; do
    [[ -z "$profile" ]] && continue
    remove_shell_block "$profile"
  done < <(all_known_shell_profiles)
}

check_install() {
  local wrapper current_dir current_script
  local status=0

  wrapper="$(command -v codex-test 2>/dev/null || true)"
  current_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  current_script="$current_dir/$(basename "${BASH_SOURCE[0]}")"
  if [[ -z "$wrapper" && -f "$current_script" ]]; then
    wrapper="$current_script"
  fi
  printf 'codex-test check\n'
  printf '\n'

  if [[ -n "$wrapper" ]]; then
    printf '[ok] Wrapper: %s\n' "$wrapper"
  else
    printf '[warn] Wrapper not found on PATH. Run the installer again.\n'
    status=1
  fi

  if [[ -f "$USER_SKILL_DIR/SKILL.md" ]]; then
    printf '[ok] Skill: %s\n' "$USER_SKILL_DIR"
  else
    printf '[warn] Skill not found at %s\n' "$USER_SKILL_DIR"
    status=1
  fi

  if command -v codex >/dev/null 2>&1; then
    printf '[ok] Codex CLI: %s\n' "$(command -v codex)"
  else
    printf '[warn] Codex CLI not found. Install it with: npm install -g @openai/codex\n'
    status=1
  fi

  if [[ -n "$wrapper" ]] && "$wrapper" --version >/dev/null 2>&1; then
    printf '[ok] Version: '
    "$wrapper" --version
  fi

  printf '\n'
  if (( status == 0 )); then
    printf 'Ready. Try: codex test\n'
  else
    printf 'Not fully ready. Re-run install, then run: codex test --check\n'
  fi
  return "$status"
}

install_user_skill() {
  local src bin_dir wrapper primary_profile
  src="$(find_source_dir)" || {
    err "cannot find the codex-test source directory"
    exit 1
  }

  copy_skill "$src" "$USER_SKILL_DIR"
  bin_dir="$(choose_bin_dir)"
  mkdir -p "$bin_dir"
  wrapper="$bin_dir/codex-test"
  if [[ -f "$src/codex-test" ]]; then
    cp "$src/codex-test" "$wrapper"
  else
    cp "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")" "$wrapper"
  fi
  chmod +x "$wrapper"
  install_shell_integration "$wrapper"
  primary_profile="$(first_shell_profile)"

  printf 'Installed %s skill to %s\n' "$SKILL_NAME" "$USER_SKILL_DIR"
  printf 'Installed wrapper to %s\n' "$wrapper"
  printf 'Use: codex test\n'
  printf 'Inside Codex, use: $%s\n' "$SKILL_NAME"
  printf 'If Codex is already running and the skill does not appear, restart Codex.\n'
  finish_setup_message "$wrapper" "$primary_profile"
}

install_repo_skill() {
  local src dest wrapper primary_profile
  src="$(find_source_dir)" || {
    err "cannot find the codex-test source directory"
    exit 1
  }

  dest=".agents/skills/$SKILL_NAME"
  copy_skill "$src" "$dest"
  wrapper="$(command -v codex-test 2>/dev/null || true)"
  if [[ -z "$wrapper" ]]; then
    wrapper="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
  fi
  install_shell_integration "$wrapper"
  primary_profile="$(first_shell_profile)"

  printf 'Installed repo-local skill to %s\n' "$dest"
  printf 'Commit this directory so teammates get the same Codex skill.\n'
  printf 'This machine can now use: codex test\n'
  finish_setup_message "$wrapper" "$primary_profile"
}

uninstall_user_skill() {
  local wrapper current_script current_dir
  rm -rf "$USER_SKILL_DIR"
  uninstall_shell_integration

  wrapper="$(command -v codex-test 2>/dev/null || true)"
  current_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  current_script="$current_dir/$(basename "${BASH_SOURCE[0]}")"

  if [[ -n "$wrapper" && "$wrapper" == "$current_script" && -f "$current_dir/SKILL.md" ]]; then
    printf 'Removed skill %s\n' "$USER_SKILL_DIR"
    printf 'Leaving source checkout wrapper in place at %s\n' "$wrapper"
  elif [[ -n "$wrapper" && -w "$wrapper" ]]; then
    rm -f "$wrapper"
    printf 'Removed wrapper %s\n' "$wrapper"
  else
    printf 'Removed skill %s\n' "$USER_SKILL_DIR"
    if [[ -n "$wrapper" ]]; then
      printf 'Wrapper still exists at %s. Remove it manually if desired.\n' "$wrapper"
    fi
  fi
}

print_codex_function() {
  local wrapper
  wrapper="$(command -v codex-test 2>/dev/null || true)"
  if [[ -z "$wrapper" ]]; then
    wrapper="codex-test"
  fi
  cat <<EOF
# Add this to ~/.zshrc, ~/.bashrc, or your shell profile, then restart the shell.
# It forwards "codex test ..." to codex-test and leaves every other codex command alone.
codex() {
  if [ "\$#" -gt 0 ] && [ "\$1" = "test" ]; then
    shift
    "$wrapper" "\$@"
  else
    command codex "\$@"
  fi
}
EOF
}

MODE="interactive"
JSON_ARGS=()
GO_HAM=false
PLAN_ONLY=false
GOAL=""
TEST_MODE=""
COVERAGE_TARGET=""
TEST_KIND=""
EXTRA_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --exec|-e)
      MODE="exec"
      shift
      ;;
    --json)
      JSON_ARGS=(--json)
      shift
      ;;
    --go-ham|--yes|--auto)
      GO_HAM=true
      shift
      ;;
    --plan-only|--dry-run)
      PLAN_ONLY=true
      shift
      ;;
    --goal|--focus|--target)
      if [[ $# -lt 2 ]]; then
        err "$1 requires a value"
        exit 2
      fi
      GOAL="$2"
      shift 2
      ;;
    --mode|--workflow)
      if [[ $# -lt 2 ]]; then
        err "$1 requires a value"
        exit 2
      fi
      TEST_MODE="$(normalize_test_mode "$2")" || {
        err "invalid --mode \"$2\". Use recommended, coverage, or specialized."
        exit 2
      }
      shift 2
      ;;
    --coverage-target|--target-coverage)
      if [[ $# -lt 2 ]]; then
        err "$1 requires a value"
        exit 2
      fi
      if [[ -n "$TEST_MODE" && "$TEST_MODE" != "coverage" ]]; then
        err "--coverage-target requires --mode coverage"
        exit 2
      fi
      COVERAGE_TARGET="$(normalize_coverage_target "$2")" || {
        err "invalid --coverage-target \"$2\". Use a number from 1 to 100, such as 80 or 85%."
        exit 2
      }
      TEST_MODE="coverage"
      shift 2
      ;;
    --test-kind|--kind|--suite)
      if [[ $# -lt 2 ]]; then
        err "$1 requires a value"
        exit 2
      fi
      if [[ -n "$TEST_MODE" && "$TEST_MODE" != "specialized" ]]; then
        err "--test-kind requires --mode specialized"
        exit 2
      fi
      TEST_KIND="$2"
      TEST_MODE="specialized"
      shift 2
      ;;
    --install)
      install_user_skill
      exit 0
      ;;
    --install-repo)
      install_repo_skill
      exit 0
      ;;
    --uninstall)
      uninstall_user_skill
      exit 0
      ;;
    --check|doctor)
      check_install
      exit $?
      ;;
    --print-codex-function)
      print_codex_function
      exit 0
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --version|-v)
      printf 'codex-test v%s\n' "$VERSION"
      exit 0
      ;;
    *)
      EXTRA_ARGS+=("$1")
      shift
      ;;
  esac
done

if [[ "$MODE" == "exec" && -z "$TEST_MODE" ]]; then
  err "--exec requires --mode recommended, --mode coverage, or --mode specialized"
  exit 2
fi

if [[ "$MODE" != "exec" && -n "$TEST_MODE" ]]; then
  err "--mode is only supported with --exec. Interactive codex-test always asks the user to choose 1, 2, or 3."
  exit 2
fi

if ! command -v codex >/dev/null 2>&1; then
  err "Codex CLI not found. Install it with: npm install -g @openai/codex"
  err "On macOS you can also use: brew install --cask codex"
  exit 1
fi

PROMPT="$DEFAULT_PROMPT"
if [[ "$MODE" == "exec" ]]; then
  PROMPT="$EXEC_PROMPT"
fi

if [[ "$PLAN_ONLY" == true ]]; then
  PROMPT="$PROMPT Stop after writing the proposed plan in chat. Do not edit files."
fi

if [[ -n "$GOAL" ]]; then
  PROMPT="$PROMPT User testing goal: $GOAL"
fi
if [[ -n "$TEST_MODE" ]]; then
  PROMPT="$PROMPT Requested testing workflow mode: $TEST_MODE."
fi
if [[ -n "$COVERAGE_TARGET" ]]; then
  PROMPT="$PROMPT Requested coverage target: $COVERAGE_TARGET%."
fi
if [[ -n "$TEST_KIND" ]]; then
  PROMPT="$PROMPT Requested specialized test kind: $TEST_KIND."
fi

CODEX_ARGS=()
if [[ "$MODE" == "exec" ]]; then
  CODEX_ARGS=(--sandbox workspace-write)
fi
if [[ "$GO_HAM" == true ]]; then
  CODEX_ARGS=(--ask-for-approval never --sandbox workspace-write)
fi

if [[ "$MODE" == "exec" ]]; then
  COMMAND_ARGS=(exec)
  if ((${#CODEX_ARGS[@]})); then
    COMMAND_ARGS+=("${CODEX_ARGS[@]}")
  fi
  if ((${#JSON_ARGS[@]})); then
    COMMAND_ARGS+=("${JSON_ARGS[@]}")
  fi
  if ((${#EXTRA_ARGS[@]})); then
    COMMAND_ARGS+=("${EXTRA_ARGS[@]}")
  fi
  COMMAND_ARGS+=("$PROMPT")
  exec codex "${COMMAND_ARGS[@]}"
fi

COMMAND_ARGS=()
if ((${#CODEX_ARGS[@]})); then
  COMMAND_ARGS+=("${CODEX_ARGS[@]}")
fi
if ((${#EXTRA_ARGS[@]})); then
  COMMAND_ARGS+=("${EXTRA_ARGS[@]}")
fi
COMMAND_ARGS+=("$PROMPT")
exec codex "${COMMAND_ARGS[@]}"
